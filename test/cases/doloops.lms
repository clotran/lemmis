module doloops
  implicit none
contains
  subroutine run()
    integer :: i, j, s, n
    s = 0
    do i = 1, 10
      s = s + i
    end do
    print *, s, i
    do i = 10, 1, -3
      print *, i
    end do
    print *, i
    s = 0
    do i = 5, 1
      s = s + 1
    end do
    print *, s, i
    n = 0
    do while (n < 100)
      n = n * 2 + 1
    end do
    print *, n
    s = 0
    do i = 1, 20
      if (mod(i, 2) == 0) cycle
      if (i > 11) exit
      s = s + i
    end do
    print *, s, i
    s = 0
    do i = 1, 4
      do j = 1, 4
        if (j > i) exit
        s = s + i * j
      end do
    end do
    print *, s, i, j
    n = 0
    do
      n = n + 3
      if (n > 20) exit
    end do
    print *, n
    print *, first_square_over(50), first_square_over(0), find(3), find(11)
  end subroutine run
  integer function first_square_over(m)
    integer, intent(in) :: m
    integer :: k
    first_square_over = -1
    do k = 1, 100
      if (k * k > m) then
        first_square_over = k
        return
      end if
    end do
  end function first_square_over
  integer function find(m)
    integer, intent(in) :: m
    integer :: k
    find = -1
    do k = 1, 10
      if (k == m) then
        find = k * 10
        return
      end if
    end do
    find = 0
  end function find
end module doloops
