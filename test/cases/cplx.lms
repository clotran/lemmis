module cplx
  implicit none
contains
  subroutine run()
    complex :: z, w
    complex(8) :: d
    z = (1.5, -2.0)
    w = (0.5, 1)
    print *, z + w, z - w, -z
    print *, real(z), aimag(z), conjg(z)
    d = (1.0d0, 2.0d0)
    print *, d + z, d == (1.0d0, 2.0d0), z /= w
    z = 3
    print *, z, z * 2
    d = cmplx(0.25d0, 0.5d0, kind=8)
    print *, d
  end subroutine run
end module cplx
