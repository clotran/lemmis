module intrinsics
  implicit none
contains
  subroutine run()
    real(8) :: x
    real :: y
    integer :: i
    x = -2.75d0; y = 2.5
    print *, abs(x), abs(-7), sign(3, -1), sign(2.5d0, 1.0d0), min(3, 1, 2), max(1.5, 2.5, -1.0)
    print *, int(x), nint(x), floor(x), ceiling(x), nint(y), nint(-y), int(x, 8), kind(int(x, 8))
    print *, real(7) / 2, dble(1) / 3, real(x, 4), kind(real(x)), sqrt(2.0d0), sqrt(2.0)
    print *, huge(1), huge(1_8), epsilon(1.0), epsilon(1.0d0), digits(1.0d0)
    print *, exp(1.0d0), log(10.0d0), sin(0.5d0), cos(0.5d0), atan(1.0d0), atan2(1.0d0, -1.0d0)
    i = 17
    print *, mod(i, 5), modulo(-i, 5), mod(5.5d0, 2.0d0), modulo(-5.5d0, 2.0d0)
  end subroutine run
end module intrinsics
