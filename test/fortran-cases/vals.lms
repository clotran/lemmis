! val: a local of its expression's type (tier A), in every kind
module vals
  implicit none
contains
  subroutine run()
    integer :: i
    integer(1) :: b
    real :: s
    b = 7_1
    s = 0.1
    val a = b + 3_2
    val c = s * 2
    val d = c + 0.1d0
    val z = cmplx(s, 2, 8) + (1.0, 0.5)
    val t = 'ab' // 'cde'
    val p = a > 9 .and. c < 1.0
    print *, a, kind(a), c, d, z, t, len(t), p
    val r = abs((3.0, 4.0)) + aimag(z)
    val r8 = real(b, 8)
    val r4 = real(z)
    print *, r, r8, r4
    do i = 1, 3
      val sq = i * i
      val half = sq / 2.0
      if (sq > 3) then
        val big = sq * 1000_8
        print *, big, kind(big)
      end if
      print *, sq, half
    end do
    val u = trim(t // '   ') // '!'
    print *, u, len(u)
    val sq = 2.5d0
    val i2 = sq * 2
    print *, sq, i2
    if (b > 0) then
      val sq = 'shadow'
      print *, sq, len(sq)
    end if
    print *, sq
  end subroutine run
end module vals
