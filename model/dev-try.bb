#!/usr/bin/env bb
;; dev-try.bb BOOK EVENT (from model/; BOOK without .lisp): iterate on one lemma fast.
;; DEV ONLY: never included by a book, never part of a gate; a book still has to
;; certify under `make model`. It writes build/dev-try-BOOK.lsp, which loads BOOK's
;; events BEFORE EVENT with proofs skipped (set-ld-skip-proofsp, in the scratch file
;; only), then submits EVENT with proofs. The whole ACL2 output goes to
;; build/dev-try-BOOK.log; this prints pass/fail and the key checkpoints (<= 60 lines).
;; The book's own earlier events must be (re)loadable: its includes must be certified.
(require '[clojure.string :as str] '[babashka.fs :as fs] '[babashka.process :as p] '[clojure.java.io :as io])
(def here (str (fs/parent (fs/absolutize *file*))))
(def acl2 (or (System/getenv "ACL2") "/Users/james/clotran/acl2/saved_acl2"))
(def kinds #"^\((?:make-event\s+`\()?(?:defthmd?|defund?|defun-sk|defmacro|defconst|defun-nx|defund-nx|defabbrev|defstobj|defrec)\s+([^\s()]+)")

(defn forms
  "top-level forms of a Lisp source string, as [start end) offsets (skips ; and #| |# comments, strings, #\\x, |sym|)"
  [s]
  (let [n (count s)]
    (loop [i 0 depth 0 start nil acc []]
      (if (>= i n) acc
        (let [c (.charAt s i) nx (when (< (inc i) n) (.charAt s (inc i)))]
          (cond
            (= c \;) (recur (let [j (.indexOf s "\n" i)] (if (neg? j) n j)) depth start acc)
            (and (= c \#) (= nx \|)) (recur (+ 2 (.indexOf s "|#" i)) depth start acc)
            (and (= c \#) (= nx \\)) (recur (+ i 3) depth start acc)
            (= c \") (let [j (loop [j (inc i)] (cond (= (.charAt s j) \\) (recur (+ j 2)) (= (.charAt s j) \") j :else (recur (inc j))))]
                       (recur (inc j) depth start acc))
            (= c \|) (recur (inc (.indexOf s "|" (inc i))) depth start acc)
            (= c \() (recur (inc i) (inc depth) (or start i) acc)
            (= c \)) (if (= depth 1) (recur (inc i) 0 nil (conj acc [start (inc i)])) (recur (inc i) (dec depth) start acc))
            :else (recur (inc i) depth start acc)))))))

(let [[book ev] *command-line-args*
      _ (when-not (and book ev) (println "usage: bb dev-try.bb BOOK EVENT") (System/exit 2))
      src (slurp (str here "/" book ".lisp"))
      fs* (forms src)
      txt (fn [[a b]] (subs src a b))
      idx (first (keep-indexed (fn [i f] (when (= (str/lower-case ev) (str/lower-case (or (second (re-find kinds (txt f))) ""))) i)) fs*))
      _ (when-not idx (println "dev-try: no event" ev "in" book ".lisp") (System/exit 2))
      pkg (str/join "\n" (filter #(str/starts-with? % "(in-package") (map txt (take idx fs*))))
      prefix (remove #(str/starts-with? % "(in-package") (map txt (take idx fs*)))
      scratch (str here "/../build/dev-try-" book ".lsp")
      log (str here "/../build/dev-try-" book ".log")]
  (fs/create-dirs (fs/parent scratch))
  (spit scratch (str "; DEV ONLY, generated by dev-try.bb; not a book, never certified.\n" pkg "\n"
                     "(set-cbd \"" here "/\")\n(set-ld-skip-proofsp t state)\n" (str/join "\n" prefix) "\n"
                     "(set-ld-skip-proofsp nil state)\n(cw \"~%DEVTRY-BEGIN~%\")\n" (txt (nth fs* idx)) "\n(cw \"~%DEVTRY-END~%\")\n"))
  (let [t0 (System/currentTimeMillis)
        r (p/shell {:dir here :in (str "(ld \"" scratch "\" :ld-error-action :error)\n(good-bye)\n") :out (io/file log) :err :out :continue true
                    :extra-env {"ACL2_USELESS_RUNES" (or (System/getenv "ACL2_USELESS_RUNES") "read?")}} acl2)
        out (slurp log)
        tail (second (str/split out #"DEVTRY-BEGIN" 2))
        ok (and tail (str/includes? tail "DEVTRY-END") (not (re-find #"FAILED|ACL2 Error|HARD ACL2 ERROR" tail)))
        lines (str/split-lines (or tail out))
        key (when (seq lines)
              (let [a (first (keep-indexed (fn [i l] (when (str/includes? l "Key checkpoint") i)) lines))]
                (if a (take 40 (drop a lines))
                    (take-last 25 (filter #(re-find #"FAILED|ERROR|Error|Goal|Subgoal|Summary|Time:" %) lines)))))]
    (println (if ok "PASS" "FAIL") book ev (format "(%.1fs; log build/dev-try-%s.log)" (/ (- (System/currentTimeMillis) t0) 1000.0) book))
    (when-not tail (println "(the prefix itself failed to load:)") (doseq [l (take-last 20 (str/split-lines out))] (println l)))
    (doseq [l (take 55 key)] (println l))
    (System/exit (if ok 0 1))))
