; gen-st-heap: clotran's heapgn stobj functions past hpg-spush, as ACL2 hands
; them over ((fn formals stobjs-out guards-verified body), check-gen's dump),
; for check-gen (model/check-gen.bb) to translate by gen-st's g-st-module and
; compare with clotran's src/f/gen/heap_gen.inc. The first four are
; translated: hpg-drain (a tail loop in a subroutine, CALLs), hpg-run-from-batch
; (mv/mv-nth, an intent(out) result), hpg-run-take (the results' tuple, a CALL
; to its dest), hpg-next-tail (a FUNCTION reading the stobj, calling others
; given it), hpg-seq-op (likewise). The rest are their callees: their formals and results only.

(in-package "ACL2")

(include-book "gen-st")

(defconst *heapg-st-raw*
  '(
    (hpg-drain (fuel hpg)
               (hpg)
               t
               (if (if (zp fuel)
                       (zp fuel)
                     (if (zp (h-msp hpg))
                         (zp (h-msp hpg))
                       (not (equal (h-err hpg) '0))))
                   hpg
                 ((lambda (sp fuel hpg)
                    ((lambda (tag fuel hpg sp)
                       ((lambda (ref tag fuel hpg sp)
                          ((lambda (hpg fuel ref tag)
                             ((lambda (hpg fuel)
                                (hpg-drain (binary-+ '-1 fuel) hpg))
                              (if (if (equal tag '8)
                                      (if (< '0 ref)
                                          (< ref '1099511627776)
                                        'nil)
                                    'nil)
                                  (hpg-scan-obj ref '0 hpg)
                                (if (if (equal tag '9) (< '0 ref) 'nil)
                                    (hpg-scan-vec ref hpg)
                                  hpg))
                              fuel))
                           (update-h-msp sp hpg)
                           fuel ref tag))
                        (h-mrefi sp hpg)
                        tag fuel hpg sp))
                     (h-mtagi sp hpg)
                     fuel hpg sp))
                  (binary-+ '-1 (h-msp hpg))
                  fuel hpg)))
    (hpg-run-from-batch (c l hpg)
                        (nil hpg)
                        t
                        ((lambda (mv l c)
                           ((lambda (off hpg l c)
                              (if (< '0 off)
                                  (cons off (cons hpg 'nil))
                                (hpg-run-new c l hpg)))
                            (mv-nth '0 mv)
                            (mv-nth '1 mv)
                            l c))
                         (hpg-run-pop c hpg)
                         l c))
    (hpg-run-take (n batching hpg)
                  (nil hpg)
                  t
                  (if (not (< '0 n))
                      (cons '0 (cons hpg 'nil))
                    ((lambda (c batching hpg)
                       ((lambda (l hpg batching c)
                          (hpg-run-take-c c l batching hpg))
                        (hpg-class-len c '1 '1)
                        hpg batching c))
                     (hpg-size-class n '1 '1)
                     batching hpg)))
    (hpg-next-tail
         (o hpg)
         (nil)
         t
         ((lambda (w hpg)
            ((lambda (tg hpg w)
               ((lambda (tr w hpg tg)
                  (if (equal tg '0)
                      '1
                    (if (not (hpg-obj-at tg tr hpg))
                        '0
                      (if (equal (hpg-okd tr hpg) '1)
                          (if (< '0 (hpg-oi tr hpg)) w '1)
                        (if (equal (hpg-okd tr hpg) '6)
                            ((lambda (case-do-not-use-elsewhere tr w)
                               (if (eql case-do-not-use-elsewhere '1)
                                   w
                                 (if (eql case-do-not-use-elsewhere '2)
                                     '1
                                   (if (eql case-do-not-use-elsewhere '3)
                                       (binary-+ '1 (binary-* '5 tr))
                                     '0))))
                             (hpg-oi tr hpg)
                             tr w)
                          '0)))))
                (hpg-or w hpg)
                w hpg tg))
             (hpg-ot w hpg)
             hpg w))
          (binary-+ '2 (binary-* '5 o))
          hpg))
    (hpg-seq-op (op tag ref hpg)
                (nil)
                t
                (if (not (if (equal op '9)
                             (equal op '9)
                           (if (equal op '39)
                               (equal op '39)
                             (if (equal op '27)
                                 (equal op '27)
                               (equal op '10)))))
                    '0
                  (if (equal tag '0)
                      (if (equal op '10) '0 '1)
                    (if (not (hpg-obj-at tag ref hpg))
                        '0
                      ((lambda (kd n b hpg ref op)
                         (if (equal kd '6)
                             (if (equal op '27)
                                 (if (eql n '1)
                                     '2
                                   (if (eql n '2)
                                       '1
                                     (if (eql n '3) (binary-+ '1 b) '0)))
                               (if (equal op '9)
                                   (if (eql n '1)
                                       (binary-+ '1 b)
                                     (if (eql n '2) '1 '0))
                                 (if (equal op '10)
                                     (if (equal n '1) (binary-+ '2 b) '0)
                                   (if (equal op '39)
                                       (if (eql n '1)
                                           (hpg-next-tail ref hpg)
                                         (if (eql n '2) '1 '0))
                                     '0))))
                           (if (equal kd '1)
                               (if (equal op '9)
                                   (if (< '0 n) b '1)
                                 (if (equal op '27)
                                     (if (< '0 n) '2 '1)
                                   '0))
                             '0)))
                       (hpg-okd ref hpg)
                       (hpg-oi ref hpg)
                       (binary-* '5 ref)
                       hpg ref op)))))
    (hpg-scan-obj (i k hpg)
                  (hpg)
                  t
                  (if (if (not (natp k))
                          (not (natp k))
                        (not (< k '5)))
                      hpg
                    ((lambda (j i k hpg)
                       (if (if (< j (h-otag-length hpg))
                               (< j (h-oref-length hpg))
                             'nil)
                           ((lambda (hpg k i)
                              (hpg-scan-obj i (binary-+ '1 k) hpg))
                            (hpg-push (h-otagi j hpg)
                                      (h-orefi j hpg)
                                      hpg)
                            k i)
                         hpg))
                     (binary-+ (binary-* '5 i) k)
                     i k hpg)))
    (hpg-scan-vec (i hpg)
                  (hpg)
                  t
                  (if (if (< i (h-voff-length hpg))
                          (< i (h-vlen-length hpg))
                        'nil)
                      ((lambda (off n hpg)
                         (if (if (not (< '1099511627776 off))
                                 (if (not (< '1099511627776 n))
                                     (not (< '1099511627776 (binary-+ off n)))
                                   'nil)
                               'nil)
                             (hpg-scan-run off (binary-+ off n) hpg)
                           hpg))
                       (nfix (h-voffi i hpg))
                       (nfix (h-vleni i hpg))
                       hpg)
                    hpg))
    (hpg-run-pop (c hpg)
                 (nil hpg)
                 t
                 (if (if (not (< c '1))
                         (if (not (< '8 c))
                             (< c (h-nrb-length hpg))
                           'nil)
                       'nil)
                     ((lambda (n hpg c)
                        (if (if (< '0 n)
                                (if (not (< '64 n))
                                    (< (binary-+ (binary-* (binary-+ '-1 c) '64)
                                                 n)
                                       (h-rb-length hpg))
                                  'nil)
                              'nil)
                            ((lambda (off hpg n c)
                               (if (< '0 off)
                                   ((lambda (hpg off)
                                      (cons off (cons hpg 'nil)))
                                    (update-h-nrbi c (binary-+ '-1 n) hpg)
                                    off)
                                 (cons '0 (cons hpg 'nil))))
                             (h-rbi (binary-+ (binary-* (binary-+ '-1 c) '64)
                                              n)
                                    hpg)
                             hpg n c)
                          (cons '0 (cons hpg 'nil))))
                      (h-nrbi c hpg)
                      hpg c)
                   (cons '0 (cons hpg 'nil))))
    (hpg-run-new (c l hpg)
                 (nil hpg)
                 t
                 ((lambda (h l c hpg)
                    (if (if (< '0 h)
                            (< h (h-aival-length hpg))
                          'nil)
                        ((lambda (hpg l h)
                           ((lambda (hpg h l)
                              ((lambda (hpg h)
                                 (cons h (cons hpg 'nil)))
                               (update-h-asince (hpg-add (h-asince hpg) l)
                                                hpg)
                               h))
                            (update-h-areu (hpg-add (h-areu hpg) '1)
                                           hpg)
                            h l))
                         (update-h-cheadi c (hpg-s64 (h-aivali h hpg))
                                          hpg)
                         l h)
                      (if (if (< '0 l)
                              (not (< (h-acap hpg)
                                      (binary-+ (h-aused hpg) l)))
                            'nil)
                          ((lambda (off l hpg)
                             ((lambda (hpg l off)
                                ((lambda (hpg off l)
                                   ((lambda (hpg off)
                                      (cons off (cons hpg 'nil)))
                                    (update-h-asince (hpg-add (h-asince hpg) l)
                                                     hpg)
                                    off))
                                 (update-h-afre (hpg-add (h-afre hpg) '1)
                                                hpg)
                                 off l))
                              (update-h-aused (binary-+ (h-aused hpg) l)
                                              hpg)
                              l off))
                           (binary-+ '1 (h-aused hpg))
                           l hpg)
                        (cons '0 (cons hpg 'nil)))))
                  (if (< c (h-chead-length hpg))
                      (h-cheadi c hpg)
                    '0)
                  l c hpg))
    (hpg-run-take-c (c l batching hpg)
                    (nil hpg)
                    t
                    (if (if (not (equal batching '0))
                            (not (< '8 c))
                          'nil)
                        (if (if (< c (h-nrb-length hpg))
                                (equal (h-nrbi c hpg) '0)
                              'nil)
                            ((lambda (hpg l c)
                               (hpg-run-from-batch c l hpg))
                             (hpg-runs-fill c l '64 hpg)
                             l c)
                          (hpg-run-from-batch c l hpg))
                      (hpg-run-new c l hpg)))
    (hpg-ot (j hpg)
            (nil)
            t
            (if (if (not (< j '0))
                    (< j (h-otag-length hpg))
                  'nil)
                (h-otagi j hpg)
              '-1))
    (hpg-or (j hpg)
            (nil)
            t
            (if (if (not (< j '0))
                    (< j (h-oref-length hpg))
                  'nil)
                (h-orefi j hpg)
              '-1))
    (hpg-obj-at (tag ref hpg)
                (nil)
                t
                (if (equal tag '8)
                    (if (< '0 ref)
                        (if (< ref '1099511627776)
                            (if (< (binary-+ '4 (binary-* '5 ref))
                                   (h-otag-length hpg))
                                (< (binary-+ '4 (binary-* '5 ref))
                                   (h-oref-length hpg))
                              'nil)
                          'nil)
                      'nil)
                  'nil))
    (hpg-okd (o hpg)
             (nil)
             t
             (if (if (not (< o '0))
                     (< o (h-okind-length hpg))
                   'nil)
                 (h-okindi o hpg)
               '-1))
    (hpg-oi (o hpg)
            (nil)
            t
            (if (if (not (< o '0))
                    (< o (h-oi1-length hpg))
                  'nil)
                (h-oi1i o hpg)
              '-1))
    (hpg-size-class (n c p)
                    (nil)
                    t
                    (if (if (not (natp p))
                            (not (natp p))
                          (if (< p '1)
                              (< p '1)
                            (if (not (< p n))
                                (not (< p n))
                              (if (< '1099511627776 p)
                                  (< '1099511627776 p)
                                (if (not (natp c))
                                    (not (natp c))
                                  (not (< c '64)))))))
                        c
                      (hpg-size-class n (binary-+ '1 c)
                                      (binary-* '2 p))))
    (hpg-class-len (c k p)
                   (nil)
                   t
                   (if (if (not (natp c))
                           (not (natp c))
                         (if (not (natp k))
                             (not (natp k))
                           (if (not (< k c))
                               (not (< k c))
                             (< '64 c))))
                       (hpg-n40 p)
                     (hpg-class-len c (binary-+ '1 k)
                                    (hpg-n40 (binary-* '2 (hpg-n40 p))))))))

(assert-event (mv-let (e ps) (g-st-module *heapg-st-raw* '(hpg-obj-at) '(hpg-drain hpg-run-from-batch hpg-run-take hpg-next-tail hpg-seq-op) *heapg-st*)
                (and (not e) (= (len ps) 5))))
