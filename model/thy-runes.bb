;; thy-runes.bb LOG BOOK CONST EVENT... (from model/): write BOOK.lisp, the
;; constant CONST: for each EVENT (a defthm name), the runes its proof used
;; in LOG, a certification read with useless-runes (ACL2_USELESS_RUNES=read?).
;; A proof given (union-theories those (theory 'minimal-theory)) runs as fast
;; writing useless-runes as reading them. (:type-prescription len) always
;; joins: the minimal theory's linear arithmetic over len needs it.
;;
;;   bb thy-runes.bb ../build/fstmt-complete.log fstmt-complete-thy "*fsc-runes*" FYS-FIRST ...
(require '[clojure.string :as str])
(let [[log book const & evs] *command-line-args*
      s (slurp log)
      entry (fn [ev]
              (let [i (str/index-of s (str "Form:  ( DEFTHM " ev " ...)"))
                    _ (assert i ev)
                    j (str/index-of s "Rules: " i)
                    blk (subs s (+ j 7) (apply min (keep #(str/index-of s % j) ["Splitter rules" "Warnings:" "Time:"])))
                    rs (->> (re-seq #"\((:[A-Z-]+) ([^()]+?)\)" blk)
                            (remove #(str/starts-with? (second %) ":FAKE-RUNE"))
                            (map #(str "(" (str/lower-case (nth % 1)) " " (str/lower-case (nth % 2)) ")")))
                    rs (distinct (cons "(:type-prescription len)" rs))]
                (str " (" (str/lower-case ev) "\n  "
                     (str/join "\n  " (map #(str/join " " %) (partition-all 7 rs))) ")")))]
  (spit (str book ".lisp")
        (str "; " book ": generated by thy-runes.bb from a read-mode certification of\n"
             "; the book that includes it; each event's runes, the theory its proof uses\n"
             "; (so writing useless-runes is as fast as reading them). Regenerate after\n"
             "; changing those proofs: bb thy-runes.bb LOG " book " " const " EVENT...\n"
             "\n(in-package \"ACL2\")\n\n(defconst " const "\n '(\n"
             (str/join "\n" (map entry evs)) "))\n"))
  (println "wrote" (str book ".lisp")))
